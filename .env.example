# ========================================================
# n8n TikTok Monitor - Environment Template
# ========================================================

# n8n Community Activation Key (free from n8n.io)
N8N_LICENSE_ACTIVATION_KEY=your_license_activation_key_here

# n8n Default Owner Login (password must be a bcrypt hash, not plaintext)
N8N_OWNER_EMAIL=admin@example.org
N8N_OWNER_PASSWORD_HASH=your_bcrypt_password_hash_here

# Scraper & AI keys (injected into n8n via compose)
APIFY_API_TOKEN=your_apify_api_token_here
GEMINI_API_KEY=your_gemini_api_key_here
